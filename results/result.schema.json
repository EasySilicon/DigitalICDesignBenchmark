        },
        "functional_groups": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "object",
            "required": [
              "cases_passed",
              "cases_total"
            ],
            "properties": {
              "cases_passed": {
                "type": "integer",
                "minimum": 0
              },
              "cases_total": {
                "type": "integer",
                "minimum": 0
              },
              "safety_violation": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "score_items": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "required": [
              "id",
              "layer",
              "points",
              "possible_points"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "layer": {
                "enum": [
                  "F",
                  "P"
                ]
              },
              "points": {
                "type": "number",
                "minimum": 0
              },
              "possible_points": {
                "type": "number",
                "minimum": 0
              },
              "cases_passed": {
                "type": "integer",
                "minimum": 0
              },
              "cases_total": {
                "type": "integer",
                "minimum": 0
              },
              "safety_violation": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
