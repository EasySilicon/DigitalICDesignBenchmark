{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easysilicon.example/schemas/ic-benchmark-model-result-v3.json",
  "title": "Digital IC benchmark task result",
  "type": "object",
  "required": [
    "schema_version",
    "model",
    "task_id",
    "trial_kind",
    "delivery_qualified",
    "time_limit_seconds",
    "functional_total",
    "functional_possible",
    "full_functional_pass",
    "ppa_score",
    "time_score",
    "display_score",
    "score_status",
    "ranking_eligible"
  ],
  "dependentRequired": {"physical_policy": ["physical_records"]},
  "properties": {
    "physical_policy": {
      "const": "physical-wall-3600s-retain-results-v1"
    },
    "physical_records": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "policy_id",
          "limit_seconds",
          "task_id",
          "candidate_source_sha256",
          "layout_seed",
          "elapsed_seconds",
          "status"
        ],
        "properties": {
          "policy_id": {
            "const": "physical-wall-3600s-retain-results-v1"
          },
          "limit_seconds": {
            "const": 3600
          },
          "layout_seed": {
            "enum": [
              11,
              29,
              47
            ]
          },
          "elapsed_seconds": {
            "type": "number",
            "minimum": 0
          },
          "status": {
            "enum": [
              "completed",
              "timeout"
            ]
          },
          "process_group_terminated": {
            "type": "boolean"
          }
        }
      }
    },
    "physical_timed_out_seeds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          11,
          29,
          47
        ]
      }
    },
    "ppa_status": {
      "type": "string"
    },
    "candidate_source_sha256": {
      "type": "string"
    },
    "schema_version": {"const": 3},
    "model": {"type": "string", "minLength": 1},
    "task_id": {"pattern": "^T(0[1-9]|10)$"},
    "trial_kind": {"enum": ["official", "pre_release_pilot", "diagnostic"]},
    "delivery_qualified": {"type": ["boolean", "null"]},
    "delivery_penalty_policy": {
      "type": "string",
      "minLength": 1
    },
    "delivery_penalty_status": {
      "enum": [
        "adjudicated",
        "pending"
      ]
    },
    "delivery_penalty_pending_reason": {
      "type": "string",
      "minLength": 1
    },
    "delivery_assessment": {
      "type": "object",
      "required": [
        "missing_deliverables",
        "errors"
      ],
      "additionalProperties": false,
      "properties": {
        "missing_deliverables": {
          "type": "array",
          "items": {
            "enum": [
              "rtl/",
              "rtl/files.f",
              "verif/",
              "run.sh",
              "results.json",
              "README.md"
            ]
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "root_cause",
              "attribution"
            ],
            "properties": {
              "root_cause": {
                "type": "string",
                "minLength": 1
              },
              "attribution": {
                "enum": [
                  "candidate",
                  "infrastructure",
                  "pending"
                ]
              },
              "detail": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "candidate_delivery_error_count": {"type": "integer", "minimum": 0},
    "candidate_delivery_penalty": {"type": ["number", "null"], "minimum": 0},
    "display_score_before_candidate_penalty": {"type": "number", "minimum": 0, "maximum": 105},
    "candidate_delivery_error_details": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "time_limit_seconds": {"type": "number", "exclusiveMinimum": 0},
    "functional_total": {"type": ["number", "null"], "minimum": 0, "maximum": 50},
    "functional_possible": {"const": 50},
    "full_functional_pass": {"type": ["boolean", "null"]},
    "ppa_eligible": {"type": ["boolean", "null"]},
    "ppa_score": {"type": ["number", "null"], "minimum": 0, "maximum": 50},
    "ppa_possible": {"const": 50},
    "time_score": {"type": ["number", "null"], "minimum": 0, "maximum": 5},
    "time_possible": {"const": 5},
    "display_score": {"type": ["number", "null"], "minimum": 0, "maximum": 105},
    "display_possible": {"const": 105},
    "score_status": {"type": "string", "minLength": 1},
    "ranking_eligible": {"type": "boolean"},
    "ranking_ineligible_reason": {"type": "string"},
    "benchmark_freeze": {
      "type": "object",
      "required": ["receipt", "receipt_sha256", "reference_source_sha256", "scope"],
      "properties": {
        "receipt": {"enum": ["benchmark/tasks/T08/FREEZE.json", "benchmark/tasks/T09/FREEZE.json"]},
        "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reference_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "scope": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "delivery_penalty_policy"
        ],
        "properties": {
          "delivery_penalty_policy": {
            "const": "delivery-contract-cap10-v1"
          }
        }
      },
      "then": {
        "required": [
          "delivery_penalty_status",
          "candidate_delivery_penalty"
        ],
        "properties": {
          "candidate_delivery_penalty": {
            "enum": [
              0,
              5,
              10,
              null
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "delivery_penalty_status": {
                  "const": "pending"
                }
              }
            },
            "then": {
              "required": [
                "delivery_penalty_pending_reason"
              ],
              "properties": {
                "candidate_delivery_penalty": {
                  "type": "null"
                },
                "display_score": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "candidate_delivery_penalty": {
                  "enum": [
                    0,
                    5,
                    10
                  ]
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {"properties": {"trial_kind": {"const": "official"}}, "required": ["trial_kind"]},
      "then": {"properties": {"delivery_qualified": {"type": "boolean"}, "functional_total": {"type": "number"}, "full_functional_pass": {"type": "boolean"}, "display_score": {"type": "number"}}}
    }
  ],
  "additionalProperties": true
}
