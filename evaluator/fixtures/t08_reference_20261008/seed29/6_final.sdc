current_design mac_1g_repair
###############################################################################
# Timing Constraints
###############################################################################
create_clock -name logic_clk_clock -period 1000.0000 [get_ports {logic_clk}]
set_propagated_clock [get_clocks {logic_clk_clock}]
create_clock -name tx_clk_clock -period 1000.0000 [get_ports {tx_clk}]
set_propagated_clock [get_clocks {tx_clk_clock}]
create_clock -name rx_clk_clock -period 1000.0000 [get_ports {rx_clk}]
set_propagated_clock [get_clocks {rx_clk_clock}]
set_clock_groups -name group1 -asynchronous \
 -group [get_clocks {logic_clk_clock}]\
 -group [get_clocks {rx_clk_clock}]\
 -group [get_clocks {tx_clk_clock}]
set_input_delay 200.0000 -clock [get_clocks {rx_clk_clock}] -add_delay [get_ports {cfg_accept_priority}]
set_input_delay 200.0000 -clock [get_clocks {rx_clk_clock}] -add_delay [get_ports {cfg_accept_untagged}]
